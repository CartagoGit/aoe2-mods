  "mainObjectiveChain": {
    "o1": "Collect three separate local contexts and deliver each to destination-1 (hub-1); collect both unique original couriers staged at hub-6.",
    "o2": {
      "payment": "one atomic once-only 160 wood + 40 gold transaction at destination-1, paidFlag o2.req-1.paid",
      "generation": "two distinct once-only derived identities (outbound-local-brief-1, retained-local-index-1), each references the same three collected inputs and the exact o2 payment receipt; no new debit",
      "assessment": "the two generated products do not substitute for one another"
    },
    "o3": {
      "deliveries": "outbound brief + outbound courier to destination-4 (SE); retained index + record courier to destination-3 (NE)",
      "payment": "one atomic once-only transaction with allocations: destination-4 gets 140 food + 60 wood; destination-3 gets 100 food + 60 wood (total 240 food + 120 wood)",
      "receipts": "req-3 is outbound courier receipt at destination-4; req-4 is record courier receipt at destination-3",
      "wording": "objective says pay once at each court; contract models a single atomic transaction with two receiver allocations, not two independent payment receipts"
    },
    "o4": {
      "outboundCourier": "departure only after o3.req-3 (SE receipt), then same identity arrives at destination-6 (north) after its own departure",
      "recordCourier": "departure only after o3.req-4 (NE receipt), then same identity arrives at destination-6 after its own departure",
      "assessment": "separate matched receipt/departure/return chains; initial northern placement cannot satisfy arrivalAfterDeparture; no off-map Constantinople delivery is represented"
    },
    "causality": "Sequential o1→o2→o3→o4. Records of collection/receipt do not assert current custody. Generated products are fictional gameplay objects."
  },
