{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/**/*.ts",
    "tools/cli/**/*.ts",
    "tools/design/**/*.ts",
    "tests/**/*.ts"
  ]
}
